# Раздача собранного кабинета внутри контейнера. Внешний Caddy стоит перед ним
# и занимается TLS; здесь только статика и одно правило SPA.
:8080 {
	root * /srv
	encode gzip zstd
	# Одностраничное приложение: маршруты живут в браузере, и на прямой заход по
	# внутреннему адресу сервер обязан отдать index, а не 404.
	try_files {path} /index.html
	file_server
}
