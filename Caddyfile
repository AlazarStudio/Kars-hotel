# Kars Hotel PMS — обратный прокси для развёртывания на СВОЁМ VPS.
# Caddy терминирует TLS (авто-HTTPS через Let's Encrypt) и разводит один домен
# между кабинетом и API.
#
# Что нужно до первого запуска: записи A/AAAA домена смотрят на этот VPS, а
# порты 80/443 открыты — иначе ACME-проверка не пройдёт и сертификата не будет.
{
	# Почта для регистрации в ACME. Переопределяется переменной окружения.
	email {$ACME_EMAIL:admin@karsavia.ru}
}

{$PMS_DOMAIN:pms.karsavia.ru} {
	# API и кабинет НА ОДНОМ домене — так адрес API в сборке кабинета
	# относительный (`/api`), и смена домена не требует пересборки фронта.
	# Порядок важен: правило пути объявлено раньше, иначе кабинет перехватит
	# и запросы к API тоже.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:8080
	}

	encode gzip zstd

	# Партнёрский API (Kars Avia) ходит сюда же по /api/connect/v1 с ключом.
	# Отдельного домена ему не нужно: ключ и права проверяет само приложение,
	# а разводить один контур по двум именам значит завести второй сертификат
	# и второе место, где что-нибудь однажды разойдётся.
	log {
		output file /var/log/caddy/pms.log {
			roll_size 20mb
			roll_keep 10
		}
	}
}
