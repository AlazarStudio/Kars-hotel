# Kars Hotel PMS — обратный прокси для развёртывания на СВОЁМ VPS.
# Caddy терминирует TLS (авто-HTTPS через Let's Encrypt) и разводит один домен
# между кабинетом и API.
#
# Что нужно до первого запуска: записи A/AAAA домена смотрят на этот VPS, а
# порты 80/443 открыты — иначе ACME-проверка не пройдёт и сертификата не будет.
{
	# Почта для регистрации в ACME. Переопределяется переменной окружения.
	email {$ACME_EMAIL:admin@karsavia.ru}
}

{$PMS_DOMAIN:pms.karsavia.ru} {
	# API и кабинет НА ОДНОМ домене — так адрес API в сборке кабинета
	# относительный (`/api`), и смена домена не требует пересборки фронта.
	# Порядок важен: правило пути объявлено раньше, иначе кабинет перехватит
	# и запросы к API тоже.
	handle /api/* {
		reverse_proxy api:3001
	}

	# Фото гостиниц и категорий: публичное чтение бакета MinIO путём
	# /<бакет>/<ключ> — ровно таким адресом их пишет StorageService
	# (S3_PUBLIC_URL + /kars-hotel/...). Загрузка идёт только через api.
	handle /kars-hotel/* {
		@read method GET HEAD
		reverse_proxy @read minio:9000
		respond 405
	}

	handle {
		reverse_proxy web:8080
	}

	encode gzip zstd

	# Партнёрский API (Kars Avia) ходит сюда же по /api/connect/v1 с ключом.
	# Отдельного домена ему не нужно: ключ и права проверяет само приложение,
	# а разводить один контур по двум именам значит завести второй сертификат
	# и второе место, где что-нибудь однажды разойдётся.
	# Журнал доступа (152-ФЗ, Р-13, решение владельца 24; план 12.3): 90 дней
	# (roll_keep_for; roll_keep с запасом, чтобы резал срок, а не счётчик).
	# Адрес с токеном — это ключ: кто прочёл журнал, тот принял бы чужое
	# приглашение в кабинет или вошёл бы по SSO. Поэтому токены в пути
	# (`/invite/…`, `/api/auth/invite/…`) и в параметрах `token=`, `code=` —
	# `***`; заголовки-ключи партнёра удаляются (Authorization и Cookie Caddy
	# скрывает сам); Referer удаляется — он уносит адрес страницы с токеном.
	# Новый вид ссылки с токеном в пути — дописать в выражение ниже.
	log {
		output file /var/log/caddy/pms.log {
			roll_size 20MiB
			roll_keep 500
			roll_keep_for 2160h
		}
		format filter {
			wrap json
			fields {
				request>uri regexp "(^/invite/|^/api/auth/invite/|[?&](?:token|code)=)[^/?&]+" "${1}***"
				request>headers>X-Api-Key delete
				request>headers>X-Hotel-Key delete
				request>headers>X-Webhook-Secret delete
				request>headers>Referer delete
			}
		}
	}
}
