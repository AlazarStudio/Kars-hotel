# Kars Hotel PMS — боевое окружение на своём VPS.
# Скопируйте в .env и заполните. Файл .env в гит не коммитится.

# Домен кабинета. На него должны смотреть записи A/AAAA, иначе Caddy не
# получит сертификат: ACME-проверка ходит на этот адрес.
PMS_DOMAIN=pms.karsavia.ru
ACME_EMAIL=admin@karsavia.ru

# База. Пароль обязателен — compose откажется стартовать без него, и это
# намеренно: умолчание вида «postgres» на машине с белым адресом живёт до
# первого сканера.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kars_hotel

# Секреты подписи токенов (access и refresh). Свои, длинные, не из примера.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Резервные копии: час запуска по UTC и срок хранения в днях.
BACKUP_AT_HOUR=3
BACKUP_KEEP_DAYS=14

# Вебхуки в Kars Avia: адрес приёмника и общий секрет (X-Webhook-Secret).
# Пусто — события партнёру не шлются.
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=
