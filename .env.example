# Kars Hotel PMS — боевое окружение на своём VPS.
# Скопируйте в .env и заполните. Файл .env в гит не коммитится.

# Домен кабинета. На него должны смотреть записи A/AAAA, иначе Caddy не
# получит сертификат: ACME-проверка ходит на этот адрес.
PMS_DOMAIN=pms.karsavia.ru
ACME_EMAIL=admin@karsavia.ru

# База. Пароль обязателен — compose откажется стартовать без него, и это
# намеренно: умолчание вида «postgres» на машине с белым адресом живёт до
# первого сканера.
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=kars_hotel
# Пароль рантайм-роли app_user (без прав обхода RLS). Роль создаётся один раз:
#   docker compose exec -T postgres psql -U postgres -d kars_hotel <<'SQL'
#   CREATE ROLE app_user LOGIN PASSWORD '<пароль>';
#   GRANT USAGE ON SCHEMA public TO app_user;
#   GRANT SELECT,INSERT,UPDATE,DELETE ON ALL TABLES IN SCHEMA public TO app_user;
#   GRANT USAGE,SELECT ON ALL SEQUENCES IN SCHEMA public TO app_user;
#   ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
#     GRANT SELECT,INSERT,UPDATE,DELETE ON TABLES TO app_user;
#   ALTER DEFAULT PRIVILEGES FOR ROLE postgres IN SCHEMA public
#     GRANT USAGE,SELECT ON SEQUENCES TO app_user;
#   SQL
APP_DB_PASSWORD=

# Секреты подписи токенов (access и refresh). Свои, длинные, не из примера.
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# Резервные копии: час запуска по UTC и срок хранения в днях.
BACKUP_AT_HOUR=3
BACKUP_KEEP_DAYS=14

# Внешняя шифрованная копия (152-ФЗ, Р-14; план 12.4; подробно — backup/run.sh).
# Открытый ключ age (age1…): закрытый хранится ВНЕ сервера, у ответственного.
BACKUP_AGE_RECIPIENT=
# rclone-адрес: offsite:<бакет>[/префикс]. Хранилище в РФ у другого провайдера.
BACKUP_REMOTE=
BACKUP_S3_PROVIDER=Other
BACKUP_S3_ENDPOINT=
BACKUP_S3_REGION=ru-central1
# Ключ сервера — ТОЛЬКО НА ЗАПИСЬ (PutObject), без чтения, списка и удаления.
# Срок — правилом бакета: db/ старше 62 дней удаляется.
BACKUP_S3_KEY_ID=
BACKUP_S3_SECRET=
# Монитор «пульса» (протокол healthchecks): успех — адрес, сбой — адрес/fail,
# тишина дольше суток с запасом — тревога у монитора.
BACKUP_PING_URL=

# Вебхуки в Kars Avia: адрес приёмника и общий секрет (X-Webhook-Secret).
# Пусто — события партнёру не шлются.
PARTNER_WEBHOOK_URL=
PARTNER_WEBHOOK_SECRET=

# На бою адреса наружу — только https://: с http:// в PMS_DOMAIN или
# PARTNER_WEBHOOK_URL API не стартует (152-ФЗ, план 12.1).
# yes — временный режим без доменов, осознанно.
ALLOW_INSECURE_HTTP=
